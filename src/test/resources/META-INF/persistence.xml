<?xml version="1.0" encoding="UTF-8"?>

<persistence
        xmlns="https://jakarta.ee/xml/ns/persistence"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            https://jakarta.ee/xml/ns/persistence
            https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
        version="3.0">

    <persistence-unit name="ProjMONOAchievements"
                      transaction-type="JTA">

        <jta-data-source>java:jboss/datasources/ConquistasTestDS</jta-data-source>

        <class>com.fabioperettig.domain.User</class>
        <class>com.fabioperettig.domain.Achievement</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.hbm2ddl.auto"
                      value="create-drop"/>

            <property name="hibernate.show_sql"
                      value="true"/>
        </properties>
    </persistence-unit>

</persistence>
